<?xml version="1.0" encoding="utf-8"?>
<!--
   Regras de cópia de segurança para Android 11 e anteriores (android:fullBackupContent).
   A sessão (refresh token cifrado com uma chave do Android Keystore) nunca entra em cópias:
   a chave não é copiada, por isso o ficheiro seria inútil noutro aparelho, e não deve sair deste.
-->
<full-backup-content>
    <exclude domain="file" path="session/" />
</full-backup-content>
