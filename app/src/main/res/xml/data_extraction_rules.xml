<?xml version="1.0" encoding="utf-8"?>
<!--
   Regras de cópia de segurança e de transferência entre aparelhos (Android 12+).
   A sessão (refresh token cifrado com uma chave do Android Keystore) é excluída de ambas.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="session/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="session/" />
    </device-transfer>
</data-extraction-rules>
