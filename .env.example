# Copiar para .env (que não é versionado) e substituir as palavras-passe.
# Valores de demonstração apenas para desenvolvimento local.

# Administrador do PostgreSQL (só para inicialização e manutenção; os serviços não o usam).
POSTGRES_ADMIN_USER=portofit_admin
POSTGRES_ADMIN_PASSWORD=altera-me-admin

# Utilizador próprio do catalog-service, sem privilégios de administração.
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=altera-me-catalog

# Utilizador próprio do users-service, sem privilégios de administração.
USERS_DB_USER=users_user
USERS_DB_PASSWORD=altera-me-users

# Utilizador próprio do experiences-service, sem privilégios de administração.
EXPERIENCES_DB_USER=experiences_user
EXPERIENCES_DB_PASSWORD=altera-me-experiences

# Chave interna entre o experiences-service e o users-service (feed-context, E4). Gerar um valor aleatório longo,
# por exemplo: python -c "import secrets; print(secrets.token_urlsafe(32))"
USERS_INTERNAL_KEY=altera-me-chave-interna

# Utilizador próprio do collections-service, sem privilégios de administração.
COLLECTIONS_DB_USER=collections_user
COLLECTIONS_DB_PASSWORD=altera-me-collections

# Chave interna entre o collections-service e o experiences-service (consulta em lote). Gerar um valor aleatório longo.
COLLECTIONS_INTERNAL_KEY=altera-me-chave-colecoes

# Utilizador próprio do messaging-service, sem privilégios de administração.
MESSAGING_DB_USER=messaging_user
MESSAGING_DB_PASSWORD=altera-me-messaging

# Chave interna entre o messaging-service e o experiences-service (consulta em lote). Exclusiva deste serviço:
# tem de ser diferente da COLLECTIONS_INTERNAL_KEY. Gerar um valor aleatório longo.
MESSAGING_INTERNAL_KEY=altera-me-chave-mensagens
